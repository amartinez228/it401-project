# Application owner setup only; visitors do not need RapidAPI accounts or keys.
# Copy this file to .env on the server, then replace the example values with those
# shown in the RapidAPI endpoint's code snippet. Never commit your .env file.
SECRET_KEY=replace-with-a-random-development-secret
RAPIDAPI_KEY=replace-with-your-rapidapi-key
RAPIDAPI_HOST=streaming-availability.p.rapidapi.com
RAPIDAPI_BASE_URL=https://streaming-availability.p.rapidapi.com
RAPIDAPI_SEARCH_PATH=/shows/search/title
RAPIDAPI_QUERY_PARAMETER=title
RAPIDAPI_COUNTRY=us

# IMDb236 random recommendations (uses RAPIDAPI_KEY unless IMDB_API_KEY is set).
IMDB_API_HOST=imdb236.p.rapidapi.com
IMDB_API_BASE_URL=https://imdb236.p.rapidapi.com
IMDB_RANDOM_PATH=/api/imdb/random

# Reserved for a future AI provider integration.
AI_SERVICE_API_KEY=

# Persistence (owner/server configuration). URL-encode special password characters.
DATABASE_URL=mysql+pymysql://betterboxd:replace-with-db-password@127.0.0.1:3306/betterboxd?charset=utf8mb4
# Required for POST/PATCH/DELETE /api/records; never send this token to public pages.
ADMIN_API_TOKEN=replace-with-a-long-random-owner-token
API_CACHE_TTL_SECONDS=86400
IMDB_CACHE_TTL_SECONDS=900
SCRAPE_CACHE_TTL_SECONDS=3600
CACHE_MAX_STALE_SECONDS=604800

# Only used by the optional local MySQL Docker Compose service.
MYSQL_PASSWORD=replace-with-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
