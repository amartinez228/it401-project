# Copy this file to .env, then replace the example values with the values
# shown in the RapidAPI endpoint's code snippet. Never commit your .env file.
SECRET_KEY=replace-with-a-random-development-secret
RAPIDAPI_KEY=replace-with-your-rapidapi-key
RAPIDAPI_HOST=streaming-availability.p.rapidapi.com
RAPIDAPI_BASE_URL=https://streaming-availability.p.rapidapi.com
RAPIDAPI_SEARCH_PATH=/shows/search/title
RAPIDAPI_QUERY_PARAMETER=title
RAPIDAPI_COUNTRY=us

# Reserved for a future AI provider integration.
AI_SERVICE_API_KEY=
